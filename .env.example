# Identifiants du trunk ou de l'extension SIP 3CX.
# Le mot de passe ne doit pas être commité : copier ce fichier vers .env.
SIP_USER=
SIP_PASSWORD=
# Nom d'hôte ou IP du PBX, sans préfixe sip: et sans port.
SIP_DOMAIN=
SIP_PORT=5060

# Optionnel.
# SIP_TRANSPORT=udp
# SIP_LOCAL_PORT=5060
# SIP_AUTH_USER=
# SIP_PUBLIC_ADDRESS=
# RTP_PORT=4000
# GREETING_WAV=assets/greeting_fr.wav
# LOG_LEVEL=INFO
